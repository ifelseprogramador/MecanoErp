# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (https://supabase.com/dashboard -> Project Settings).
#
# Atenção com senhas/segredos que contêm "#": em arquivo .env, "#" inicia
# um comentário e trunca o resto da linha. Coloque o valor entre aspas
# duplas quando ele tiver "#" (ex.: SEED_ADMIN_PASSWORD="Minha#Senha123").

# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role (secreta! nunca expor ao
# cliente, nunca prefixar com NEXT_PUBLIC_). Usada pelo script de seed
# (src/db/seed.ts) e pela área /admin (core/supabase/admin.ts) para criar
# usuários via Admin API contornando confirmação de e-mail.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI
# Use o pooler em modo "Transaction" (porta 6543) — necessário para
# ambientes serverless (Vercel). Adicione ?sslmode=require se pedido.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Seed (src/db/seed.ts): dados da primeira organização/usuário de teste.
SEED_ORG_NAME="Oficina Exemplo"
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=troque-esta-senha

# Seed: seu login como dono da plataforma (área /admin — bloquear/
# desbloquear oficina, cobrança, apagar dados). Se deixar em branco, usa
# SEED_OWNER_EMAIL/PASSWORD (só prático para teste local; em produção,
# defina o SEU e-mail de verdade aqui).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
